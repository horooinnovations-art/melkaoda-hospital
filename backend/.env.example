PORT=5000
NODE_ENV=development
APP_NAME="Gambo General Hospital"
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:5000
PUBLIC_API_URL=http://localhost:5000/api/v1

# Existing MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gambo_hospital
DB_USERNAME=root
DB_PASSWORD=

# Required: use a long random string. Never use "dev-secret" in any shared environment.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Bootstrap admin — on each boot the API keeps this email's password in sync
# with ADMIN_PASSWORD (so env credentials always work for that account).
# Set ADMIN_SYNC_PASSWORD=0 if you manage that user's password only in the UI.
ADMIN_EMAIL=admin@gambohospital.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME="System Administrator"
# ADMIN_SYNC_PASSWORD=1
# Force rewrite even if sync is disabled:
# ADMIN_RESET_PASSWORD=1

# Cloudinary is required in production (Render disk is ephemeral).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Shared Cloudinary account still hosts assets under deder-hospital.
CLOUDINARY_FOLDER=deder-hospital
MEDIA_STORAGE_HOST=

# SSL: prefer MYSQL_ATTR_SSL_CA as a PEM string or path to a .pem file.
# DB_SSL_INSECURE=1 enables TLS without verifying the cert (explicit opt-in only).
DB_SSL=false
# DB_SSL_INSECURE=false
# MYSQL_ATTR_SSL_CA=
