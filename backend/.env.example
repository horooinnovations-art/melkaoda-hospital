# ─── Melka Oda General Hospital — API environment ────────────────────────────
# Copy to backend/.env and fill in. Never commit the filled-in file.

PORT=5000

# NODE_ENV drives every production guard: env validation, error masking, the
# Cloudinary requirement, CORS strictness and trust-proxy defaults. The deployed
# API was running with NODE_ENV=development, which silently disabled all of them
# (MEL-DEPLOY-001). In a real deployment this MUST be "production".
NODE_ENV=development
# Set to production only alongside NODE_ENV=production — validateEnv() now fails
# the boot if these two disagree.
APP_ENV=development

APP_NAME="Melka Oda General Hospital"

# Required in production. CORS fails closed without it: every cross-origin
# request is denied rather than allowed (MEL-SEC-008). Comma-separate multiples.
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:5000
PUBLIC_API_URL=http://localhost:5000/api/v1

# Number of reverse proxies in front of this process. Render's edge is 1; the
# Next.js rewrite proxy in front of it makes 2. Without this, req.ip is the
# proxy for every request, so all rate limiters share one bucket and every
# audit-log IP is wrong (MEL-DEVOPS-001). Must match reality — too high lets a
# client forge its own X-Forwarded-For. Defaults to 2 when NODE_ENV=production.
# TRUST_PROXY_HOPS=2

# ─── Database ────────────────────────────────────────────────────────────────
# Use a database dedicated to this deployment. The Aiven instance this project
# shipped pointing at is shared with the Deder, Loke and Gambo sites — one
# `users` table, so an admin of any of them can sign in here (MEL-ENV-001).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=melkaoda_hospital
DB_USERNAME=root
DB_PASSWORD=

# TLS. Put the provider's CA certificate in MYSQL_ATTR_SSL_CA — a PEM string or
# a path to a .pem file — and leave DB_SSL_INSECURE unset.
DB_SSL=false
# MYSQL_ATTR_SSL_CA=
#
# DB_SSL_INSECURE=1 encrypts the connection but does not verify the server
# certificate, so an active attacker on the path can read and rewrite traffic,
# credentials included. The deployment had this switched on (MEL-SEC-005).
# Production validation now refuses to boot with it set. Local use only.
# DB_SSL_INSECURE=1

# Boot-time DDL/DML. bootstrapSchema() adds columns and tables on start; set
# this to 0 on any shared or production database and run `npm run migrate`
# instead (MEL-ENV-001).
# SCHEMA_BOOTSTRAP=0

# ─── Auth ────────────────────────────────────────────────────────────────────
# At least 32 characters of real randomness: `openssl rand -base64 48`.
# Production refuses to boot on anything shorter or low-entropy (MEL-SEC-011).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Administrators ──────────────────────────────────────────────────────────
# Used ONLY to create the very first admin on an empty database. It no longer
# reactivates, un-deletes or re-passwords an existing account on every boot —
# that made administrator offboarding un-enforceable (MEL-SEC-002).
# Must not be one of the inherited defaults (admin@gambohospital.com,
# admin@lokehospital.com, admin@dederhospital.com): production rejects those.
ADMIN_EMAIL=
# At least 12 characters in production.
ADMIN_PASSWORD=
ADMIN_NAME="System Administrator"

# Break-glass recovery, off by default. Set to 1 for ONE boot to reset
# ADMIN_EMAIL's password to ADMIN_PASSWORD and reactivate the account, then
# remove it and redeploy.
# ADMIN_RESET_PASSWORD=1

# Comma-separated addresses holding users.is_root_admin — the tier that can view
# and manage other super admins. This is the only supported way to grant it; the
# column is unreachable from any request body. Previously the tier was anyone
# whose own name or email contained "admin", which was self-grantable
# (MEL-SEC-001). If left unset, the oldest active super admin is promoted so the
# tier is never empty, and a warning is logged.
ROOT_ADMIN_EMAILS=

# ─── Media ───────────────────────────────────────────────────────────────────
# Required in production — Render's disk is ephemeral.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# This project's own namespace. It defaulted to "deder-hospital", so uploads
# landed in a sibling project's folder (MEL-CFG-002).
CLOUDINARY_FOLDER=melkaoda-hospital
MEDIA_STORAGE_HOST=

# ─── Not used by this API ────────────────────────────────────────────────────
# MAIL_*, APP_KEY, CACHE_STORE, SESSION_*, QUEUE_CONNECTION, DB_CONNECTION,
# FILESYSTEM_DISK and MIGRATE_FRESH are Laravel settings inherited from the
# original CMS. This is an Express app and reads none of them. The deployed
# environment carried a plaintext Gmail password in MAIL_PASSWORD for no
# functional reason — delete them rather than carrying credentials nothing uses.
