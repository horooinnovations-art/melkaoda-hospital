# Melka Oda General Hospital — API environment for cPanel
#
# Copy to `.env` in the API application root and fill in. cPanel's "Setup
# Node.js App" screen also has an environment-variable table; either works, but
# pick ONE and keep it authoritative — values set in both places diverge and the
# file wins, which is confusing at 2am.
#
# Every variable below is read at boot. The API refuses to start on an invalid
# production configuration rather than running unprotected.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Passenger assigns the port itself and overrides this; it is here for the rare
# case of running the app outside Passenger to debug.
PORT=5000
APP_NAME="Melka Oda General Hospital"

# Apache/Passenger puts exactly one reverse proxy in front of this process.
# Too high lets a client forge X-Forwarded-For and evade rate limiting; too low
# puts every visitor in one bucket and one person's login attempts lock out all
# administrators.
TRUST_PROXY_HOPS=1

# Schema changes are applied deliberately with `npm run migrate`, never as a
# side effect of a restart. Passenger restarts the app on almost anything.
SCHEMA_BOOTSTRAP=0

# ── URLs ─────────────────────────────────────────────────────────────────────
# The public site. CORS denies every cross-origin request not on this list, so
# an error here presents as "the admin panel loads but nothing saves".
FRONTEND_URL=https://melkaoda.horooinnovations.com

# This API's own public base, used to build absolute media URLs.
APP_URL=https://melkaodaapi.horooinnovations.com
PUBLIC_API_URL=https://melkaodaapi.horooinnovations.com/api/v1

# Host that serves /uploads. Same as APP_URL unless media is on another domain.
MEDIA_STORAGE_HOST=https://melkaodaapi.horooinnovations.com

# ── Database (cPanel MySQL) ──────────────────────────────────────────────────
# cPanel prefixes both the database and the user with the account name, e.g.
# "cpaneluser_melkaoda". Use the full prefixed names.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_melkaoda
DB_USERNAME=cpaneluser_melkaoda
DB_PASSWORD=

# The database is on the same machine, so the connection never leaves it and
# TLS buys nothing. Leave DB_SSL off — turning it on without a CA makes the app
# refuse to build a pool at all.
DB_SSL=false

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
# At least 32 characters. This is the only thing between a stranger and a forged
# administrator token — and changing it signs everyone out, which is also the
# fastest way to revoke access in an incident.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Bootstrap administrator ──────────────────────────────────────────────────
# Used only when the database contains no administrator at all. On every later
# boot this account is left exactly as it is.
# Generate: openssl rand -base64 24
# Must be >= 16 characters across three character classes, and must not contain
# "admin", "hospital", "melkaoda" or similar — the API rejects those at boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="System Administrator"

# One-shot break-glass. Recreates and re-passwords ADMIN_EMAIL on the next
# restart. Set it, restart, sign in, then REMOVE it and restart again.
# ADMIN_RESET_PASSWORD=1

# Comma-separated addresses that hold the root-admin tier — the only accounts
# that can manage other super admins. Applied at boot, so it takes effect only
# while SCHEMA_BOOTSTRAP is on; with it off, set users.is_root_admin by SQL.
ROOT_ADMIN_EMAILS=

# ── Media storage ────────────────────────────────────────────────────────────
# "local" — files on this account's disk. Correct for cPanel: the disk is as
# durable as the database. uploads/ and storage/ then hold the only copy of
# every image, document and résumé, so both MUST be in your backup routine.
# "cloudinary" — files on Cloudinary. Correct for ephemeral hosts (Render).
MEDIA_DRIVER=local

# Public, web-served uploads. Relative paths resolve from the application root.
UPLOAD_DIR=uploads
# Applicant résumés. Deliberately OUTSIDE UPLOAD_DIR so no path under it is
# reachable over HTTP; the API streams these itself, and logs who opened what.
PRIVATE_UPLOAD_DIR=storage/private

# Only needed when MEDIA_DRIVER=cloudinary.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=melkaoda-hospital

# ── Mail ─────────────────────────────────────────────────────────────────────
# Without these, contact replies, job-application receipts and password resets
# are silently never delivered. Create the mailbox in cPanel → Email Accounts
# and use its own credentials; do not reuse a personal Gmail password.
MAIL_HOST=mail.horooinnovations.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=no-reply@melkaoda.horooinnovations.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@melkaoda.horooinnovations.com
MAIL_FROM_NAME="Melka Oda General Hospital"

# ── Tuning ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# `view` audit rows were 63% of the table and buried what mattered.
AUDIT_LOG_VIEWS=0
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
JSON_BODY_LIMIT=512kb
