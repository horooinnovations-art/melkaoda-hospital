{
  "name": "melkaoda-hospital-api",
  "version": "1.0.0",
  "description": "Melka Oda General Hospital API - Express + MySQL",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "migrate": "node src/scripts/migrate.js",
    "migrate:leadership-history": "node src/scripts/migrateLeadershipHistory.js",
    "repair:public-content": "node src/scripts/repairPublicContent.js",
