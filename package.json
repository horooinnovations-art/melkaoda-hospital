{
  "name": "melkaoda-general-hospital",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Melka Oda General Hospital \u2014 Next.js + Express + MySQL",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev:api": "node --watch backend/src/server.js",
    "dev:web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "package:cpanel": "node scripts/package-cpanel.mjs",
    "migrate": "npm --prefix backend run migrate",
    "test": "npm --prefix backend test",
    "archive:cpanel": "bash scripts/archive-cpanel.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "slugify": "^1.6.6",
    "uuid": "^11.0.5"
  }
}
