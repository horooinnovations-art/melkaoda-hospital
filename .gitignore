# Reference Laravel upload — do not commit into the monorepo
deder.horooinnovations.com/

# NOTE: there was a `backend/*.json` rule here. It was meant to exclude a few
# scratch API captures, but it also excluded backend/package.json and
# backend/package-lock.json — so the published repository contained a backend
# with no manifest and no lockfile. It could not be installed, CI could not
# cache or `npm ci` it, and the cPanel bundles only worked because the packaging
# script copies those files from the working tree rather than from git.
# The scratch captures are named individually further down instead.


# Database dumps. Two 5.2 MB backups containing users.password hashes and
# contact_submissions PII were committed and pushed before this rule existed
# (MEL-DATA-001). Keep dumps in object storage, never in git.
*.sql
!database/migrations/*.sql
!database/leadership_history.sql
!media-recovery.sql

# Lighthouse / profiling output
lighthouse-*.json
audit-report.html

# Copies of deployed environment variables. These hold live secrets — JWT
# signing key, DB and Cloudinary credentials, SMTP password. Never commit them.
deployed_env_file/
*.env
!*.env.example

# Scratch API captures. Named one by one rather than with a `backend/*.json`
# glob, so that a real backend manifest or config file can never be silently
# excluded again.
backend/home*.json
backend/doctors.json
backend/settings.json
docs/**/*.local.md

# cPanel deployment bundles produced by `npm run package:cpanel`. Rebuild them,
# never commit them — the web bundle alone is 80 MB and contains node_modules.
dist-cpanel/
